PORT=3001
JWT_SECRET=***REMOVED***
ADMIN_PASSWORD=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:5173/auth/discord

# Discord Bot für Sprachaufzeichnung (optional)
# Kann dieselbe Discord-Anwendung wie der OAuth2-Login sein. Das Bot-Token
# findest du im "Bot"-Tab der App und ist nicht dasselbe wie CLIENT_SECRET.
# Der Bot braucht Berechtigungen: Connect, Speak, View Channel, Use Voice Activity.
DISCORD_BOT_TOKEN=
# Discord-Server-ID, in dem Aufnahmen stattfinden sollen
DISCORD_GUILD_ID=
# Sprache für Whisper-Transkription (de, en, auto, ...)
WHISPER_LANGUAGE=de
# Modell-Größe für lokales Whisper (tiny, base, small, medium, large)
WHISPER_MODEL=base
# Python-Executable für das Whisper-Transkriptionsscript. Wird automatisch
# ermittelt (python3, python, ...), falls nicht gesetzt.
# PYTHON_COMMAND=python3
# FP16-Beschleunigung für Whisper aktivieren (true/false). Standard: false
# WHISPER_FP16=false

# AI (optional)
AI_PROVIDER=opencode
AI_MODEL=provider/GLM5.2
# Optional: günstigeres Modell für kurze KI-Aufgaben wie Tagebuch-Zusammenfassungen.
# Falls nicht gesetzt, wird AI_MODEL verwendet.
# AI_CHEAP_MODEL=provider/GLM5.2
# AI_OPENCODE_BIN=opencode

# MCP (optional, wird für KI-Tool-Use verwendet)
# Falls nicht gesetzt, wird JWT_SECRET verwendet.
# MCP_TOKEN_SECRET=***REMOVED***
