PORT=3001
# Secret for MCP session tokens (see MCP_TOKEN_SECRET below). Dashboard login
# sessions no longer use it: they are RS256-signed JWTs backed by the RSA key
# pair under data/keys/, which is generated automatically on first start.
JWT_SECRET=change-me-in-production
# Number of days until the dashboard login session expires (default: 7)
JWT_EXPIRES_IN_DAYS=7
# Required if Discord OAuth is configured. Must be a base64-encoded 32-byte key.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Required: password for the default 'admin' account
ADMIN_PASSWORD=
# Local development only: opening the dashboard signs in as the initial admin
# automatically, without password or Discord. Never active in production.
DEV_AUTO_LOGIN=false
# Production releases run migrations in the deployment transaction before the
# current release is switched. Keep this false in production.
DND_RUN_MIGRATIONS_ON_STARTUP=false
# Directory where images pasted onto the whiteboard are stored.
WHITEBOARD_UPLOAD_DIR=data/whiteboard
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:5173/auth/discord

# Discord bot for voice recording (optional)
# Can be the same Discord application as the OAuth2 login. The bot token
# can be found in the "Bot" tab of the app and is not the same as CLIENT_SECRET.
# The bot needs permissions: Connect, Speak, View Channel, Use Voice Activity.
DISCORD_BOT_TOKEN=
# Interval in milliseconds for refreshing stored Discord OAuth tokens and syncing
# profile data (avatar/display name). Default: 1 hour (3600000).
DISCORD_TOKEN_REFRESH_INTERVAL_MS=3600000
# Discord server ID where recordings should take place
DISCORD_GUILD_ID=
# Bootstrap fallback for Whisper before the database Admin UI language is
# available. The persisted Admin setting always takes precedence for new
# transcription processes. de/en are preferred; legacy "auto" is accepted and
# safely normalizes to German when no persisted setting exists.
WHISPER_LANGUAGE=de
# Model size for faster-whisper (tiny, base, small, medium, large-v3)
WHISPER_MODEL=base
# Python executable for the faster-whisper transcription script. Automatically
# detected (python3, python, ...) if not set.
PYTHON_COMMAND=python3
# Deprecated: faster-whisper uses compute_type (below) instead of fp16.
WHISPER_FP16=false
# faster-whisper (CTranslate2) compute type on CPU: int8 (default, fastest) or
# float16. Both keep transcription quality; int8 is recommended for CPU.
WHISPER_COMPUTE_TYPE=int8
# Optional explicit context prompt. If unset or blank, a prompt matching the
# current Admin language (de/en) is generated automatically. A non-empty custom
# value is passed unchanged and takes precedence over the generated prompt.
# WHISPER_INITIAL_PROMPT=
# Enable audio preprocessing via ffmpeg (noise reduction, normalization). Default: true
WHISPER_NOISE_REDUCE=true
# Silero VAD (built into faster-whisper) skips long pauses instead of
# transcribing them. Only pauses longer than WHISPER_VAD_MIN_SILENCE split
# speech regions; shorter pauses stay part of the same region so the model
# keeps context. Defaults: min_silence 2.0s, min_speech 0.5s.
WHISPER_VAD_MIN_SILENCE=2.0
WHISPER_VAD_MIN_SPEECH=0.5
# Keep context across consecutive speech regions (default true). If you see
# repeated/hallucinated lines, set to false.
WHISPER_CONDITION_ON_PREVIOUS=true
# no_speech_prob threshold for discarding very short, likely hallucinated segments. Default: 0.9
WHISPER_FILTER_NO_SPEECH_PROB=0.9

# AI (optional)
AI_PROVIDER=opencode
# Set to a real model, e.g. anthropic/claude-sonnet-4-20250514
AI_MODEL=opencode/deepseek-v4-flash-free
AI_OPENCODE_BIN=opencode
# The model can also be overridden persistently at runtime in the Admin UI
# (SideDrawer section "KI-Modell", stored in the ai_settings table). This takes
# precedence over the .env value.

# Bingo AI suggestions (optional)
# Number of suggestions to keep pre-generated in the pool.
# BINGO_SUGGESTION_TARGET=20
# Threshold at which the pool is refilled in the background.
# BINGO_SUGGESTION_THRESHOLD=5
# Number of suggestions generated per refill batch.
# BINGO_SUGGESTION_BATCH=15

# CORS / frontend origin (optional)
# In production, only allows requests from the given origins (comma-separated).
# If not set, no cross-origin requests are allowed in production.
CORS_ORIGIN=http://localhost:3001,https://example.com

# Set to true/1 when running behind a reverse proxy (nginx, caddy) that sets
# X-Forwarded-For / X-Forwarded-Proto. Necessary for the rate limiter to see
# the real client IP instead of the proxy's IP. Default: false.
TRUST_PROXY=false

# Logging (optional)
# Maximum number of persistent log entries in the SQLite database.
# Oldest entries are automatically deleted when the limit is exceeded.
LOG_RETENTION_MAX=100000

# MCP (optional, used for AI tool use)
# If not set, JWT_SECRET is used.
MCP_TOKEN_SECRET=change-me-in-production
