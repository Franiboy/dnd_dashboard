[Unit]
Description=D&D Dashboard opencode2 background service
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=franiboy
WorkingDirectory=/dnd_dashboard
Environment=PATH=/home/franiboy/.opencode/bin:/home/franiboy/.nvm/current/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/snap/bin
ExecStart=/home/franiboy/.opencode/bin/opencode2 serve --service
Restart=on-failure
RestartSec=3
StartLimitIntervalSec=60
StartLimitBurst=5

[Install]
WantedBy=multi-user.target