# Template for the D&D Dashboard systemd unit.
# Adjust the paths (/home/dnd, /dnd_dashboard) and the User= line to your
# deploy user and checkout location before installing (see docs/server-setup.md).
[Unit]
Description=D&D Dashboard (Node.js production)
After=network.target dnd-dashboard.socket
Wants=network-online.target
Requires=dnd-dashboard.socket

[Service]
Type=simple
User=dnd
WorkingDirectory=/dnd_dashboard
Environment=NODE_ENV=production
Environment=PATH=/home/dnd/.nvm/current/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/snap/bin
ExecStart=/home/dnd/.nvm/current/bin/node /dnd_dashboard/dist-server/server/index.js
Restart=on-failure
RestartSec=3
StartLimitIntervalSec=60
StartLimitBurst=5

[Install]
WantedBy=multi-user.target
