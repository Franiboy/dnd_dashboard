{
  "name": "dnd_dashboard",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently --handle-input --kill-others --kill-others-on-fail \"npm run server\" \"npm run client\"",
    "client": "vite",
    "server": "node --import ./node_modules/tsx/dist/loader.mjs ./server/index.ts",
    "server:watch": "node --watch --import ./node_modules/tsx/dist/loader.mjs ./server/index.ts",
    "build:server": "tsc -p tsconfig.server.json && tsx scripts/copyServerAssets.ts",
    "build:version": "tsx scripts/buildVersion.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "build": "tsc -b && vite build && npm run build:server && npm run build:version",
    "start": "node dist-server/server/index.js",
    "preview": "vite preview",
    "test:server": "DB_PATH=dnd_test.db npm run server",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --deny-warnings --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format && npm run lint:fix && npm test",
    "setup:atlas": "bash scripts/setup-projectatlas.sh",
    "prepare": "husky"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ansi-to-html": "^0.7.2",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "discord.js": "^14.26.5",
    "dompurify": "^3.4.13",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "isomorphic-dompurify": "^3.22.0",
    "jsonwebtoken": "^9.0.3",
    "libsodium-wrappers": "^0.8.4",
    "quill": "2.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-quill-new": "^3.8.3",
    "react-router-dom": "~7.18.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.3",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "oxlint": "^1.78.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "oxlint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html}": "prettier --write"
  },
  "overrides": {
    "quill": "2.0.2"
  }
}
