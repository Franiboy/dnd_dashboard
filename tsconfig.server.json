{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "outDir": "dist-server",
    "rootDir": ".",
    "declaration": false,
    "noEmit": false
  },
  "include": ["server/**/*.ts", "shared/**/*.ts", "scripts/db-migrate.ts"],
  "exclude": ["node_modules", "dist", "dist-server"]
}
